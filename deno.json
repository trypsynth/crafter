{
	"name": "crafter",
	"version": "0.1.0",
	"exports": "./src/main.ts",
	"tasks": {
		"dev": "deno run --allow-read --allow-net --allow-run --allow-env tools/serve.ts",
		"build": "deno bundle --platform=browser --minify --sourcemap=linked --outdir=dist src/main.ts",
		"check": "deno check src/main.ts tools/ tests/",
		"test": "deno test --allow-none tests/",
		"sim": "deno run src/sim/headless.ts",
		"fmt": "deno fmt",
		"lint": "deno lint",
		"smoke": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env tools/browser_smoke.ts"
	},
	"compilerOptions": {
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": false,
		"lib": [
			"deno.window",
			"dom",
			"dom.iterable",
			"esnext"
		]
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 160,
		"semiColons": true,
		"singleQuote": false,
		"exclude": [
			"dist/",
			"docs/",
			"style.css",
			"index.html",
			"*.md"
		]
	},
	"lint": {
		"exclude": [
			"dist/"
		],
		"rules": {
			"exclude": [
				"no-explicit-any"
			]
		}
	},
	"exclude": [
		"dist/",
		"docs/",
		"game.js"
	],
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@std/media-types": "jsr:@std/media-types@^1",
		"@std/path": "jsr:@std/path@^1"
	}
}
